; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DEVFramework"
run/main_scene="res://Scenes/AI/GoapDemo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bt4jisu18swhx"

[autoload]

DevMCP="*res://addons/DEVFramework/MCP/MCPDevServer.gd"

[debug]

gdscript/warnings/untyped_declaration=1.0

[dev_framework]

mcp/port=8932

[editor_plugins]

enabled=PackedStringArray("res://addons/DEVFramework/plugin.cfg", "res://addons/TweenAnimation/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
