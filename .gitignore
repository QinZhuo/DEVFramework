# Godot 4+ specific ignores
.godot/
/android/

# GDExtension 开发目录（gdextension/：C++ 源码 + CMakeLists + godot-cpp submodule）
# 构建缓存与中间产物统一由工具放在 res://.godot/gdextension_build/（已随 .godot/ 忽略），不入库
# godot-cpp 以 git submodule 引入（gdextension/godot-cpp/），
# 固定 commit 于官方仓库，内部文件不直接纳入本仓库管理
# （克隆后执行: git submodule update --init）

# addons/DEVFramework/Native/ 是发布目录（框架级共享原生库）：
# 带平台后缀的动态库（.macos.debug.arm64 等）必须提交，用户拿到即用
# 无后缀的原始编译产物（libdev.dylib 等）忽略
addons/DEVFramework/Native/libdev.dylib
addons/DEVFramework/Native/libdev.so
addons/DEVFramework/Native/libdev.dll
# Godot 加载 GDExtension 时生成的 ~ 前缀临时副本，不入库
addons/DEVFramework/Native/~*
addons/VoxelSupport/Native/~*

/.opencode
*.translation